# ==============================================================================
# Downex Download Manager — Updated Production .gitignore
# ==============================================================================

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Frontend Build Outputs & Caches
dist/
build/
.output/
.cache/
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
*.tsbuildinfo
tsconfig.node.tsbuildinfo

# Rust & Tauri Build Targets
target/
src-tauri/target/
src-tauri/gen/schemas/
**/*.rs.bk
Cargo.lock.orig

# OTA & Ship Temporary Artifacts
*.downex.bin
update*.downex.bin
*.sig
src-tauri/target/*.downex.bin
src-tauri/target/*.sig

# Local Databases & Runtime WAL
*.db
*.db-wal
*.db-shm
downex.db
downex_local.db
pids
*.pid
*.seed
*.pid.lock

# Environment Files & Secret Credentials (PRESERVED IN ENCRYPTED VAULT)
.env
.env.*
.env.local
!.env.example

# Tauri Private Signing Keys & Signing Secrets (PRESERVED IN ENCRYPTED VAULT)
.tauri/
*.key
*.pem
*.pfx
*.p12

# Local Proprietary References & Research (PRESERVED IN ENCRYPTED VAULT)
reference/
refrence/
scratch/

# Operating System & File System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Settings (Allow shared team configurations)
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# Test Coverage & Diagnostic Reports
coverage/
*.lcov
.nyc_output/
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ------------------------------------------------------------------------------
# VAULT ASSETS & DEFENSE (EXPLICITLY INCLUDED & TRACKED IN GIT)
# ------------------------------------------------------------------------------
!downex-vault.enc
.vault_attempts
test-vault-verification/


