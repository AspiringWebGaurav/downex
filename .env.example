# GPHost Asset Hosting & OTA Distribution Configuration
# NOTE: Real credentials and signing keys are stored in the encrypted vault (downex-vault.enc).
# Decrypt them using: npm run vault:unpack (You will be prompted for your master passphrase)

GPHOST_API_KEY="your_gphost_api_key_here"
VITE_GPHOST_API_KEY="your_gphost_api_key_here"
GPHOST_FOLDER="downex"
GPHOST_APP_SLUG="downex"
GPHOST_API_BASE="https://gphost.eu.cc"
