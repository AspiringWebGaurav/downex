{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Downex",
  "mainBinaryName": "downex",
  "version": "0.0.1",
  "identifier": "com.downex.manager",
  "build": {
    "beforeDevCommand": "npm run dev:frontend --silent",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Downex Download Manager",
        "width": 780,
        "height": 540,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://asset.localhost https://asset.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https:; font-src 'self' data:; connect-src 'self' https: http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* ipc: http://ipc.localhost https://ipc.localhost tauri:; object-src 'none'; frame-ancestors 'none'",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 Gaurav Patil",
    "publisher": "Gaurav Patil",
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/README.txt": "README.txt",
      "resources/core/*": "core/",
      "resources/updater/*": "updater/",
      "resources/security/*": "security/",
      "resources/license/*": "license/",
      "resources/research_and_study/*": "research_and_study/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "LICENSE.txt",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "template": "installer.nsi",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/uninstall.ico",
        "installMode": "currentUser",
        "installerHooks": "hooks.nsh"
      }
    }
  }
}
